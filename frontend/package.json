{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run content && vite dev",
		"build": "bun run content && vite build",
		"content": "bun scripts/sync-content.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@dagrejs/dagre": "^3.1.1",
		"@lezer/highlight": "^1.2.5",
		"@mediabunny/aac-encoder": "^1.60.0",
		"@mnbroatch/bondage": "4.2.4",
		"@netlify/blobs": "^11.1.1",
		"@types/leaflet": "^1.9.22",
		"codemirror": "^6.0.2",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1",
		"mediabunny": "^1.60.0",
		"svelte-codemirror-editor": "^2.1.0",
		"yarn-bound": "^0.5.5"
	}
}
